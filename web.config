<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="Python FastCGI" 
                 path="*" 
                 verb="*" 
                 modules="FastCgiModule" 
                 scriptProcessor="C:\Users\Projects\.venv\Scripts\python.exe|C:\Users\Projects\.venv\Lib\site-packages\wfastcgi.py" 
                 resourceType="Unspecified" 
                 requireAccess="Script" />
        </handlers>
        <httpErrors errorMode="Detailed"/>
    </system.webServer>
    <appSettings>
        <add key="WSGI_HANDLER" value="member_portal.wsgi.application" />
        <add key="PYTHONPATH" value="C:\Users\Projects\member_portal" />
        <add key="DJANGO_SETTINGS_MODULE" value="member_portal.settings" />
    </appSettings>
</configuration>